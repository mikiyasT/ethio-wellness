PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/ayzoncare?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/ayzoncare?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000
# false is required for http://localhost and for a phone on the same Wi-Fi.
# While false, private LAN origins (192.168.x, 10.x, 172.16–31.x) are allowed in addition to CORS_ORIGIN.
# Production HTTPS (separate web and API hosts) must set this to true: Secure + SameSite=None.
COOKIE_SECURE=false
PUBLIC_WEB_URL=http://localhost:3000
# Set to true only when you intend to wipe and reseed the database in production.
ALLOW_DESTRUCTIVE_SEED=false
# Required before Phase E. Health and seed run without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase 2 mail. Set one provider. Local dev without either logs the email in the API terminal.
EMAIL_FROM=አይዞን <bookings@ayzoncare.com>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# Daily.co secret. Without it, join stays a lobby and video returns video_unavailable.
DAILY_API_KEY=
