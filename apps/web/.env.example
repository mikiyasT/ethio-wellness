NEXT_PUBLIC_API_URL=http://localhost:4000
# The app always calls this API. There is no browser database fallback.
# On this computer, keep the URL as localhost. A phone on the same Wi-Fi still
# calls that computer on port 4000. The https://*.trycloudflare.com tunnel uses /backend.
# The production build must set this to the Railway API origin (https://...).
# https://app.ayzoncare.com then calls Railway directly.
# Numeric Meta pixel id. Leave empty to send no pixel events. Events stay
# PageView, InitiateCheckout, and Purchase (amount and currency only).
NEXT_PUBLIC_META_PIXEL_ID=
